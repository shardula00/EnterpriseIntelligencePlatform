# Copy this file to backend/.env before running the app or tests locally.
#
# DATABASE_URL must point at the same Postgres instance defined by
# infra/.env (host/port/user/password/db). If you used the defaults in
# infra/.env.example unchanged, the URL below already matches.
#
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg://eip_user:eip_dev_password@localhost:5432/eip_dev

APP_NAME=Enterprise Intelligence Platform
APP_ENV=local
LOG_LEVEL=INFO

# Phase 2 - ingestion. Defaults to <repo-root>/data/raw/uploads if unset;
# only override if you want uploaded files retained somewhere else.
# UPLOAD_STORAGE_DIR=E:\EnterpriseIntelligencePlatform\data\raw\uploads
MAX_UPLOAD_SIZE_MB=50

# Phase 4 - auth. JWT_SECRET_KEY has an obvious placeholder default in
# app/config.py that is fine for a solo local dev machine, but generate a
# real one before this ever runs anywhere else reachable by others:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=replace-with-a-real-generated-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Phase 4 - bootstrap admin (read only by scripts/bootstrap_admin.py, never
# by the app itself). No default password on purpose - the script refuses
# to run without one. Never commit a real value here.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-a-real-password-of-your-choosing

# Phase 5 - ML. Defaults to <repo-root>/data/ml_artifacts if unset (gitignored).
# ML_ARTIFACTS_DIR=E:\EnterpriseIntelligencePlatform\data\ml_artifacts
ML_DEFAULT_RANDOM_SEED=42
ML_MAX_TRAINING_ROWS=50000

# Phase 7 - enterprise RAG. Defaults to <repo-root>/data/raw/documents if
# unset (gitignored).
# RAG_DOCUMENT_STORAGE_DIR=E:\EnterpriseIntelligencePlatform\data\raw\documents
RAG_MAX_UPLOAD_SIZE_MB=20
RAG_CHUNK_SIZE_CHARS=1000
RAG_CHUNK_OVERLAP_CHARS=150
# "hashing" (default, zero download) or "sentence_transformers" (opt-in,
# needs `pip install sentence-transformers`) - see backend/README.md.
RAG_EMBEDDING_PROVIDER=hashing
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.15
# "local_extractive" (default, zero cost, cannot hallucinate free text),
# "ollama" (needs a local Ollama server running), or "openai_compatible"
# (needs OPENAI_API_KEY below, or any OpenAI-compatible endpoint via
# OPENAI_BASE_URL) - see backend/README.md's Phase 7 section.
RAG_LLM_PROVIDER=local_extractive
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# OPENAI_API_KEY=replace-with-a-real-key-only-if-you-opt-into-openai_compatible
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
