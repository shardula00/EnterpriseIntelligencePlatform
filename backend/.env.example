# Copy this file to backend/.env before running the app or tests locally.
#
# DATABASE_URL must point at the same Postgres instance defined by
# infra/.env (host/port/user/password/db). If you used the defaults in
# infra/.env.example unchanged, the URL below already matches.
#
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg://eip_user:eip_dev_password@localhost:5432/eip_dev

APP_NAME=Enterprise Intelligence Platform
APP_ENV=local
LOG_LEVEL=INFO

# Phase 2 - ingestion. Defaults to <repo-root>/data/raw/uploads if unset;
# only override if you want uploaded files retained somewhere else.
# UPLOAD_STORAGE_DIR=E:\EnterpriseIntelligencePlatform\data\raw\uploads
MAX_UPLOAD_SIZE_MB=50

# Phase 4 - auth. JWT_SECRET_KEY has an obvious placeholder default in
# app/config.py that is fine for a solo local dev machine, but generate a
# real one before this ever runs anywhere else reachable by others:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=replace-with-a-real-generated-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Phase 4 - bootstrap admin (read only by scripts/bootstrap_admin.py, never
# by the app itself). No default password on purpose - the script refuses
# to run without one. Never commit a real value here.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-a-real-password-of-your-choosing
