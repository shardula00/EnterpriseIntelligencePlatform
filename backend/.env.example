# Copy this file to backend/.env before running the app or tests locally.
#
# DATABASE_URL must point at the same Postgres instance defined by
# infra/.env (host/port/user/password/db). If you used the defaults in
# infra/.env.example unchanged, the URL below already matches.
#
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg://eip_user:eip_dev_password@localhost:5432/eip_dev

APP_NAME=Enterprise Intelligence Platform
APP_ENV=local
LOG_LEVEL=INFO
