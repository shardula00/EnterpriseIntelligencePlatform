# Copy this file to infra/.env before running `docker compose up`.
# These values configure the Postgres container only.
# They must match the host/port/credentials embedded in backend/.env's
# DATABASE_URL — the two files are consumed by different tools (Docker
# Compose vs. the FastAPI app) but describe the same database.

POSTGRES_USER=eip_user
POSTGRES_PASSWORD=eip_dev_password
POSTGRES_DB=eip_dev
# Host port to expose Postgres on. Kept configurable in case 5432 is
# already taken by a local Postgres install.
POSTGRES_PORT=5432

# --- Phase 12: backend/frontend containers ---
# All of these have safe local-dev defaults baked into docker-compose.yml
# itself (${VAR:-default} interpolation) - this file only needs to be
# touched if you want to override one. Never put a real secret in this
# file; it exists only as a documented template (see backend/.env.example
# for the fuller explanation of each of these).
BACKEND_PORT=8000
FRONTEND_PORT=8080
APP_ENV=local
LOG_LEVEL=INFO
# JWT_SECRET_KEY=replace-with-a-real-generated-secret
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# No default password - scripts/bootstrap_admin.py refuses to create an
# admin without a real one, same as running the backend outside Docker.
# BOOTSTRAP_ADMIN_PASSWORD=choose-a-real-local-dev-password
# VITE_API_BASE_URL=http://localhost:8000
